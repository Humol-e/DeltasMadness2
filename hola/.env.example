# Copy this file to .env and fill in the services you plan to use.
# Notice that `glacier-stage1 sar-wetsnow` works 100% offline from local/published rasters
# without any cloud credentials.

# ── Google Cloud / Google Earth Engine (optional for native GEE + GCS uploads) ──
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

GCS_BUCKET=
GCS_PREFIX=asf-sar-ingest
GEE_ASSET_COLLECTION=

# ── NASA Earthdata / ASF HyP3 (optional for ASF catalog search & InSAR/RTC jobs) ──
# Prefer EARTHDATA_TOKEN (bearer token from https://urs.earthdata.nasa.gov) or username+password:
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── Local paths & timeouts ──
LOCAL_DOWNLOAD_DIR=data/downloads
GEE_INGESTION_TIMEOUT_SEC=900
