// COMMENTED EXAMPLE of a case (Schema v2). The app supports // and /* */ comments in JSON files.
// Copy this file to public/data/cases/<your-case>/case.json (you may keep comments)
// and add the path to public/data/catalog.json. Validate with: npm run validate
{
  "schemaVersion": 2,                 // required; schema version
  "id": "my-case",                    // unique; letters, digits, _ and -
  "title": "My study site",
  "status": "demo",                   // "demo" | "real". If omitted, defaults to "demo"
  "view": { "center": [85.53, 28.22], "zoom": 11, "pitch": 45, "bearing": 0 },

  "datasets": [                       // RASTERS. Each dataset has its own timestamps (frames)
    {
      "id": "sar1",                   // no ":" or spaces
      "name": "SAR satellite 1",
      "kind": "raster",
      "status": "demo",
      // Optional metadata: null = "pending". The UI displays "pending" instead of guessing.
      "platform": null, "sensor": null, "provider": null, "product": null,
      "attribution": "Synthetic data",

      // Available variables IN THIS dataset (may differ across satellites: HH and/or HV)
      "variables": [
        { "id": "HH", "label": "HH", "quantity": "backscatter", "polarization": "HH", "unit": "dB",
          "legend": { "min": -25, "max": 0, "colors": ["#0B0F14", "#8A97A6", "#F4F7FA"] } },
        { "id": "HV", "label": "HV", "quantity": "backscatter", "polarization": "HV", "unit": "dB",
          "legend": { "min": -30, "max": -5, "colors": ["#0B0F14", "#8A97A6", "#F4F7FA"] } }
      ],

      // Optional RGB composites (image + gray8 only). One channel may be null.
      // No default composite is assigned automatically: defined explicitly per dataset.
      "composites": [
        { "id": "rgb-example", "label": "Example RGB", "channels": { "r": "HH", "g": "HV", "b": "HH" } }
      ],

      // Source file configuration:
      //  { "type": "image", "encoding": "gray8" }  local 8-bit PNG (0 = nodata; 1..255 = legend min..max)
      //  { "type": "image", "encoding": "rgba" }   pre-colored PNG/JPG (displayed as-is)
      //  { "type": "tiles", "tileSize": 256 }      XYZ tiles (URL with {z}/{x}/{y}); no swipe or pixel probe
      "source": { "type": "image", "encoding": "gray8", "nodata": 0 },

      "extent": [85.46, 28.13, 85.61, 28.31],   // [west, south, east, north] in degrees
      "crs": null,                               // pending
      "resolution": null,                        // e.g. { "value": 10, "unit": "m" }
      "render": { "opacity": 0.85, "resampling": "linear" },   // "nearest" shows crisp pixels

      // One frame per timestamp. Each source may have distinct dates.
      "frames": [
        { "id": "s1-20260304", "datetime": "2026-03-04",
          "files": { "HH": "data/cases/my-case/rasters/sar1_HH_20260304.png",
                     "HV": "data/cases/my-case/rasters/sar1_HV_20260304.png" } },
        { "datetime": "2026-03-16T05:30:00Z",   // "id" is optional; ISO 8601 time is also supported
          "files": { "HH": "data/cases/my-case/rasters/sar1_HH_20260316.png" } }   // a frame may include only a subset of variables
      ]
    }
    // Example tiled dataset (future; never store credentials in frontend, use your own proxy):
    // { "id": "modis", ..., "source": { "type": "tiles", "tileSize": 256, "minzoom": 0, "maxzoom": 10 },
    //   "frames": [ { "datetime": "2026-03-06", "files": { "T": "https://your-proxy.example/tiles/modis/20260306/{z}/{x}/{y}.png" } } ] }
  ],

  "vectors": [                        // VECTORS (GeoJSON): independent category from rasters
    {
      "id": "zones",
      "name": "Zones",
      "type": "fill",                 // "fill" | "line" | "circle"
      "status": "demo",
      "simulated": true,              // true = labeled SIMULATED on layer, panel, and legend
      // Optional indicator (snowmelt, risk, SWE, rainfall...). The app performs NO calculations:
      // if not simulated and "validation" is missing, "unvalidated" is displayed.
      "indicator": { "kind": "risk_zone", "simulated": true, "validation": null },
      "source": { "type": "geojson", "data": "data/cases/my-case/zones.geojson" },
      // Each feature stores its timestamp in properties.date (ISO 8601).
      //  "asof": shows features from the most recent date <= selected date
      //  "cumulative": shows all features up to the selected date
      "time": { "property": "date", "mode": "asof" },
      "paint": { "fill-color": "#E4572E", "fill-opacity": 0.4 },     // Mapbox GL paint style
      "legend": { "title": "Zone", "items": [{ "color": "#E4572E", "label": "SIMULATED" }] },
      "popupFields": [["zone_id", "Zone"], ["area_km2", "Area", "km²"]]   // [key, label, unit]; missing -> "Unavailable"
    }
  ]
}
