{"id": "fire-demo", "title": "Wildfire progression (illustrative)", "description": "Synthetic perimeters expanding with wind. With real data, SAR sees through smoke and clouds; coherence loss and backscatter drop help delineate burned areas.", "view": {"center": [-120.87, 39.6], "zoom": 10.6, "pitch": 0, "bearing": 0}, "timeline": [{"label": "T+0 h", "date": null, "note": "Ignition."}, {"label": "T+6 h", "date": null, "note": "Initial spread."}, {"label": "T+12 h", "date": null, "note": "Fire front elongates with wind."}, {"label": "T+24 h", "date": null, "note": "Maximum perimeter in this sample."}], "layers": [{"id": "aoi", "name": "Study area", "type": "line", "demo": true, "source": {"type": "geojson", "data": "data/cases/fire-demo/aoi.geojson"}, "paint": {"line-color": "#FF9F1C", "line-width": 2, "line-dasharray": [2, 2]}, "description": "Sample AOI boundary.", "popupFields": [["name", "Name"]]}, {"id": "perimeters", "name": "Fire perimeter", "type": "fill", "demo": true, "source": {"type": "geojson", "data": "data/cases/fire-demo/perimeters.geojson"}, "time": {"property": "step", "mode": "cumulative"}, "paint": {"fill-color": ["match", ["get", "step"], 0, "#7A1F1F", 1, "#E4572E", 2, "#F4A261", "#E9C46A"], "fill-opacity": 0.4, "fill-outline-color": "#FFFFFF"}, "legend": {"title": "Perimeter", "items": [{"color": "#7A1F1F", "label": "T+0 h"}, {"color": "#E4572E", "label": "T+6 h"}, {"color": "#F4A261", "label": "T+12 h"}, {"color": "#E9C46A", "label": "T+24 h"}]}, "description": "Cumulative perimeters: each step adds the newly reached area.", "popupFields": [["hours_since_ignition", "Hours since ignition", "h"], ["area_km2", "Area", "km²"], ["note", "Notice"]]}, {"id": "ignition", "name": "Ignition point", "type": "circle", "demo": true, "source": {"type": "geojson", "data": "data/cases/fire-demo/ignition.geojson"}, "paint": {"circle-radius": 7, "circle-color": "#FFFFFF", "circle-stroke-color": "#E4572E", "circle-stroke-width": 3}, "description": "Assumed origin